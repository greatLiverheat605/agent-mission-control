{
  "name": "@mission-control/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:e2e": "node ../../scripts/prepare-desktop-e2e.mjs",
    "test:e2e": "playwright test --config ../../playwright.config.ts",
    "test:visual": "playwright test --config playwright.config.ts",
    "tauri:dev": "cargo build -p mission-supervisor && tauri dev",
    "prepare:sidecar": "cargo build -p mission-supervisor --release --locked --offline && node ../../scripts/prepare-sidecar.mjs",
    "tauri:build": "npm run prepare:sidecar && tauri build --config src-tauri/tauri.sidecar.conf.json -- --locked --offline"
  },
  "dependencies": {
    "@mission-control/mission-store": "0.1.0",
    "@mission-control/ui": "0.1.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "pngjs": "^7.0.0",
    "typescript": "latest",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
