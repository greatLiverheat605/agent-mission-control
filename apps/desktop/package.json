{
  "name": "@mission-control/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri:dev": "cargo build -p mission-supervisor && tauri dev",
    "prepare:sidecar": "cargo build -p mission-supervisor --release && node ../../scripts/prepare-sidecar.mjs",
    "tauri:build": "npm run prepare:sidecar && tauri build --config src-tauri/tauri.sidecar.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
